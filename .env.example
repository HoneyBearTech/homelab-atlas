# Settings for one homelab-atlas installation. Copy to .env and restrict it (cp .env.example .env &&
# chmod 600 .env); .env is gitignored and never committed. Every setting the stack reads is listed here.
#
# Planned: compose.yaml doesn't exist yet (see docs/roadmap.md); these are the settings it will read.
#
# No secrets belong in this file. Each app keeps its own API key and logins in its config directory under
# APPDATA_ROOT, which is never part of the repository.

# User and group the apps run as (linuxserver.io images drop to these). Must own APPDATA_ROOT and DATA_ROOT.
PUID=1000
PGID=1000

# Time zone for logs and schedules (a tz database name).
TZ=Etc/UTC

# File creation mask: 002 keeps new files group-writable so the apps can hardlink and move each other's files.
UMASK=002

# Host directory for the apps' configuration and databases; each app gets APPDATA_ROOT/<app> as /config.
# Back this up before every upgrade (docs/upgrading.md).
APPDATA_ROOT=/srv/appdata

# Host directory holding downloads and the media library, mounted at /data in every app that moves files.
# One mount for both keeps hardlinks and instant moves working (the TRaSH Guides folder layout).
DATA_ROOT=/srv/data
