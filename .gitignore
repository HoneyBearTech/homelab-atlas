# Settings and secrets for one installation; only .env.example is committed
.env
.env.*
!.env.example
.envrc

# App data and media never belong in the repo, even if someone points APPDATA_ROOT inside the checkout
appdata/
data/

# Release and CI outputs (generated by the workflows, never committed)
compose.json
sbom.cdx.json
SHA256SUMS*
*.tar.gz

# Keys and certificates
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# The old in-repo vault path; project notes live in Chronos, never here
.obsidian-docs/

# Python tooling for scripts/ and tests/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp
