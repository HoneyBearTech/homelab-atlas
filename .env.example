# Settings for one homelab-atlas installation. Copy to .env and restrict it (cp .env.example .env &&
# chmod 600 .env); .env is gitignored and never committed. Every setting the stack reads is listed here and in
# docs/interfaces.md.
#
# No secrets belong in this file. Each app keeps its own API key and logins in its config directory (under
# CONFIG_ROOT).

# User and group the apps run as (linuxserver.io images drop to these; Recyclarr runs as them directly).
# Must be able to read and write MEDIA_ROOT and CONFIG_ROOT.
PUID=1000
PGID=1000

# Time zone for logs and schedules (a tz database name).
TZ=Etc/UTC

# File creation mask inside the linuxserver.io apps: 002 keeps new files group-writable, so the apps can hardlink
# and move each other's files without making them world-writable.
UMASK=002

# Host directory with downloads and the media library, mounted at /media in every app that moves files. Downloads
# and media must be on the same filesystem under it, so imports are hardlinks or instant moves. The apps store
# /media paths in their databases: keep the container path when you move hosts.
MEDIA_ROOT=/srv/media

# Host directory where SABnzbd assembles downloads before they're complete, mounted at /incomplete (SABnzbd stores
# that path as its temporary download folder). Can be a different disk or share from MEDIA_ROOT; completed
# downloads go under MEDIA_ROOT. Not backed up.
SABNZBD_INCOMPLETE_PATH=/srv/downloads/incomplete

# Host directory holding every app's own data, one folder per app (its service name), owned by PUID:PGID:
# - <app>/config: its settings, API key and database, mounted at /config (radarr, radarr4k, sonarr, sonarr4k,
#   lidarr, bazarr, bazarr4k, sabnzbd, and recyclarr with recyclarr.yml)
# - <app>/scripts: Radarr's and Radarr 4K's custom scripts, mounted at /scripts (radarr, radarr4k)
# - dozzle/certs: the Dozzle agent's certificate and key (dozzle_cert.pem, dozzle_key.pem), owned by root, the same
#   pair as the Dozzle hub's (docs/installing.md#dozzles-certificate); not backed up
# Back it up (scripts/backup.sh does): it holds every app's API key and logins.
# Never point it (or any path here) into /var/lib/docker/volumes: `docker volume prune`, `docker system prune
# --volumes` and Portainer's "remove unused volumes" delete every volume no container mounts as a volume, including
# one whose _data folder a service bind-mounts. Keep the data under CONFIG_ROOT, outside Docker's own directories.
CONFIG_ROOT=/srv/config

# Address range of the stack's own network (optional; default 172.25.0.0/16). Fixed so that it stays the same each
# time Compose recreates the network: a host firewall rule that allows this range keeps matching. Pick a private
# range no other Docker network or LAN on the host uses. Changing it recreates the network (every app restarts).
STACK_SUBNET=172.25.0.0/16
