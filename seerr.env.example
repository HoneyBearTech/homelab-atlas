# Optional: Seerr's database on a PostgreSQL server instead of its SQLite file. Copy to seerr.env and restrict it
# (cp seerr.env.example seerr.env && chmod 600 seerr.env); seerr.env is gitignored and never committed: it holds the
# database password. Without seerr.env, Seerr keeps its SQLite database in its config directory.
#
# The database and its login must exist first, and Seerr doesn't move its data: run it once on the empty database
# (it creates its tables), stop it, copy the data over (docs/interfaces.md#seerrenv), then start it again.
DB_TYPE=postgres
DB_HOST=db.example.com
DB_PORT=5432
DB_NAME=seerr
DB_USER=seerr
DB_PASS=
# Encrypt the connection. A server with a self-signed certificate needs DB_SSL_REJECT_UNAUTHORIZED=false; with the
# server's CA certificate, set DB_SSL_CA_FILE to its path inside the container instead and leave this true.
DB_USE_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
