# Settings for one homelab-atlas installation. Copy to .env and restrict it (cp .env.example .env &&
# chmod 600 .env); .env is gitignored and never committed. Every setting the stack reads is listed here and in
# docs/interfaces.md.
#
# No secrets belong in this file. Each app keeps its own API key and logins in its config volume.

# User and group the apps run as (linuxserver.io images drop to these; Recyclarr runs as them directly).
# Must be able to read and write MEDIA_ROOT and RECYCLARR_CONFIG_PATH.
PUID=1000
PGID=1000

# Time zone for logs and schedules (a tz database name).
TZ=Etc/UTC

# File creation mask inside the linuxserver.io apps: 002 keeps new files group-writable, so the apps can hardlink
# and move each other's files without making them world-writable.
UMASK=002

# Host directory with downloads and the media library, mounted at /media in every app that moves files. Downloads
# and media must be on the same filesystem under it, so imports are hardlinks or instant moves. The apps store
# /media paths in their databases: keep the container path when you move hosts.
MEDIA_ROOT=/srv/media

# Host directory for files that live beside the apps' config volumes (Radarr's custom scripts, mounted at
# /scripts from APPDATA_ROOT/radarr/scripts and APPDATA_ROOT/radarr4k/scripts).
APPDATA_ROOT=/srv/appdata

# Prefix of the Docker volumes that hold each app's configuration and database (<prefix>radarr, <prefix>sonarr,
# ...). Set it to the prefix your existing volumes use to keep them; a new installation can keep the default.
CONFIG_VOLUME_PREFIX=homelab-atlas_

# Host directory holding Recyclarr's config (recyclarr.yml), mounted at /config. Back it up: it holds the
# Radarr and Sonarr API keys unless you use Recyclarr's secrets file.
RECYCLARR_CONFIG_PATH=/srv/appdata/recyclarr
