// Renovate configuration. Renovate proposes every dependency update (it replaced Dependabot's version updates) and
// merges them once every required check has passed; docs/dependencies.md describes what it reads and when.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  enabled: true,

  extends: [
    "config:recommended",
    // Keep every image as name:tag@sha256:<digest> and every Action as a full commit SHA with its version in a
    // comment, and propose a new digest when a tag is rebuilt.
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    ":semanticCommitsDisabled",
  ],

  // Only the files listed in docs/dependencies.md.
  enabledManagers: ["docker-compose", "pip-compile", "github-actions", "gitlabci", "pre-commit", "custom.regex"],

  // Renovate's pre-commit manager is off by default; this turns it on for .pre-commit-config.yaml (the hook revs and
  // the `additional_dependencies` of python hooks, i.e. shellcheck-py). Its image pin is read by the regex manager
  // below, not here, so nothing is proposed twice.
  "pre-commit": {
    enabled: true,
  },

  // Mondays from 06:00 UTC.
  timezone: "Etc/UTC",
  schedule: ["* 6-9 * * 1"],
  assignees: ["HoneyBearTech"],

  // The main ruleset requires signed commits and a DCO sign-off on each one: commits made through GitHub's API are
  // signed by GitHub, and the sign-off line is the one workflows/dco.yml looks for.
  platformCommit: "enabled",
  commitBody: "Signed-off-by: {{{gitAuthor}}}",

  // Patch, minor and major updates and image rebuilds (a new digest under the same tag) are squash-merged by GitHub
  // once every required check has passed (docs/dependencies.md). A merge deploys: the server's
  // pull agent applies main within minutes, so a major, which can migrate an app's database one way, arrives
  // unattended with the nightly backup behind it.
  automerge: true,
  automergeType: "pr",
  automergeStrategy: "squash",
  platformAutomerge: true,

  // A new version (patch, minor or major) waits three days after its release before it is proposed, then merges as
  // above: a release that is pulled or fixed within days never reaches the server. Fixes for vulnerability alerts
  // skip the wait (`vulnerabilityAlerts` sets `minimumReleaseAge: null` by default), and so do rebuilds (see the
  // `digest` rule below).
  // A version update from a registry that reports no release date would be held back as pending forever
  // (`minimumReleaseAgeBehaviour` defaults to "timestamp-required"); "timestamp-optional" lets it through without
  // the wait, and versions that do have a date still wait.
  // https://docs.renovatebot.com/configuration-options/#minimumreleaseage
  // https://docs.renovatebot.com/configuration-options/#minimumreleaseagebehaviour
  minimumReleaseAge: "3 days",
  minimumReleaseAgeBehaviour: "timestamp-optional",

  // The check and test tools: requirements-dev.in lists them, requirements-dev.txt pins them with hashes. The
  // pip-compile manager reads the command in the header of requirements-dev.txt (`pip-compile --generate-hashes
  // --strip-extras requirements-dev.in`) and re-runs it for each update, so a new dependency of a tool is locked
  // too. Its pattern matches the generated file, which names the .in file as its source. The pip_requirements
  // manager is off, so the same pins aren't also bumped in place.
  "pip-compile": {
    managerFilePatterns: ["/^requirements-dev\\.txt$/"],
    // The pip-compile manager turns on a periodic lock-file refresh by default. It re-runs pip-compile for the
    // whole file and picks the newest version of every tool, with no release dates, so it would skip the three-day
    // wait and then merge by itself. Off, the tools move one at a time through ordinary updates, which wait.
    lockFileMaintenance: { enabled: false },
  },

  customManagers: [
    {
      // Images that no other manager reads, bumped by hand until now: the ones `docker run` starts in workflow
      // steps (actionlint, gitleaks, Trivy), the backup scripts' busybox (scripts/lib.sh) and the actionlint image
      // the pre-commit hook runs (.pre-commit-config.yaml; its hook revs belong to the pre-commit manager).
      customType: "regex",
      managerFilePatterns: [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/",
        "/^scripts/[^/]+\\.sh$/",
        "/^\\.pre-commit-config\\.ya?ml$/",
      ],
      matchStrings: [
        "(?<depName>[a-z0-9][a-z0-9./-]*[a-z0-9]):(?<currentValue>[A-Za-z0-9][A-Za-z0-9._-]*)@(?<currentDigest>sha256:[0-9a-f]{64})",
      ],
      datasourceTemplate: "docker",
    },
  ],

  packageRules: [
    {
      // An image rebuild (a new digest under the same tag) doesn't wait: Docker Hub dates it by the tag's last push,
      // so a tag rebuilt about weekly would restart the clock each time and never get through the Monday-only
      // schedule (https://docs.renovatebot.com/key-concepts/minimum-release-age/#digest-updates). Rebuilds are mostly
      // base-image security refreshes, and the smoke test and the required checks still gate them. Only images:
      // a moved tag on a pre-commit hook or an Action is also a "digest" update, and keeps the 3-day wait.
      matchDatasources: ["docker"],
      matchUpdateTypes: ["digest"],
      minimumReleaseAge: null,
    },
    {
      // Pin each hook repo by commit SHA with its version in a comment (`rev: <sha> # frozen: v1.2.3`), like the
      // Actions, and propose a new SHA when the tag moves.
      matchManagers: ["pre-commit"],
      pinDigests: true,
    },
    {
      // A tool is pinned twice (requirements-dev.txt for CI and `make`, .pre-commit-config.yaml for the hooks):
      // grouping usually moves both in one pull request. It is best-effort: Renovate leaves a member that hasn't
      // waited out its 3 days out of an otherwise ready group, so the two can differ for a week, which is harmless
      // (CI uses requirements-dev.txt).
      matchPackageNames: ["ruff", "astral-sh/ruff-pre-commit"],
      groupName: "ruff",
    },
    {
      matchPackageNames: ["yamllint", "adrienverge/yamllint"],
      groupName: "yamllint",
    },
    {
      matchPackageNames: ["shellcheck-py"],
      groupName: "shellcheck-py",
    },
    {
      // The smoke test's `runs-on: ubuntu-24.04` (ci.yml) matches the server's Ubuntu release, so it moves with the
      // server, by hand, not when GitHub offers a newer label.
      matchDatasources: ["github-runners"],
      enabled: false,
    },
    {
      // linuxserver.io images are pinned by their `version-<app version>` tag (version-6.4.4.10685, version-v1.6.2),
      // which always points at the newest build of that app version: a new app version is a new tag, a rebuild is a
      // new digest. The `-lsNNN` build tags are never proposed.
      matchDatasources: ["docker"],
      matchPackageNames: ["lscr.io/linuxserver/**"],
      matchCurrentValue: "/^version-/",
      versioning: "regex:^version-v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?$",
    },
  ],
}
