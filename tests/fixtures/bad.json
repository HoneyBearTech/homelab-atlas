{
  "name": "atlas",
  "services": {
    "no-image": {"build": {"context": "."}},
    "tag-only": {"image": "lscr.io/linuxserver/bazarr:1.5.3"},
    "latest": {"image": "containrrr/watchtower:latest@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"},
    "digest-only": {"image": "lscr.io/linuxserver/lidarr@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"},
    "short-digest": {"image": "lscr.io/linuxserver/sabnzbd:4.5.3@sha256:abc"},
    "privileged": {"image": "lscr.io/linuxserver/radarr:6.0.4@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "privileged": true},
    "caps": {"image": "lscr.io/linuxserver/radarr:6.0.4@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "cap_add": ["NET_ADMIN", "SYS_ADMIN"]},
    "hostnet": {"image": "lscr.io/linuxserver/radarr:6.0.4@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "network_mode": "host"},
    "hostpid": {"image": "lscr.io/linuxserver/radarr:6.0.4@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "pid": "host"},
    "socket": {
      "image": "portainer/agent:2.33.2@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "volumes": [{"type": "bind", "source": "/var/run/docker.sock", "target": "/var/run/docker.sock"}]
    }
  }
